# Cloudflare Pages headers

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# force a download rather than rendering in the tab
/files/*
  Content-Disposition: attachment
  Cache-Control: public, max-age=3600
